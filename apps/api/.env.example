# ─── Banco de Dados ───────────────────────────────────────────────────────────

# String de conexão via PgBouncer (pool de conexões do Supabase). Usada pelo
# Prisma em runtime para todas as queries. pgbouncer=true é obrigatório para
# compatibilidade com o modo transaction pooling do Supabase.
DATABASE_URL="postgresql://<role>.<project-ref>:<senha>@<host>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Conexão direta ao Postgres, sem passar pelo PgBouncer. Usada exclusivamente
# pelo Prisma para executar migrations e introspection.
DIRECT_URL="postgresql://postgres.<project-ref>:<senha>@<host>.pooler.supabase.com:5432/postgres"

# ─── Servidor ─────────────────────────────────────────────────────────────────

PORT=3000

# ─── Autenticação JWT ─────────────────────────────────────────────────────────

# String longa e aleatória (mín. 32 caracteres). Nunca reaproveitar valor de
# outro ambiente.
JWT_SECRET="change-me-to-a-long-random-secret"

JWT_EXPIRES_IN=900
JWT_REFRESH_DAYS=7

# ─── Cloudflare R2 (Storage de arquivos) ─────────────────────────────────────

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# ─── OneSignal (Notificações Push) ────────────────────────────────────────────

# Sem essas duas, o envio de push fica desabilitado silenciosamente (apenas
# warning no log) — não é obrigatório para subir a API.
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# ─── Asaas (PIX dinâmico / QR code) ──────────────────────────────────────────

# Sem ASAAS_API_KEY, POST /financial/pix/dynamic retorna 503.
ASAAS_API_KEY=
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_WEBHOOK_TOKEN=

# ─── Bíblia (leitor NVI, biblia-nvi-marcacoes-mobile) ────────────────────────

# Provedor configurado: abibliadigital.com.br (gratuito). Crie uma conta
# gratuita em https://www.abibliadigital.com.br/ para gerar o token — sem
# ele o limite é 20 requisições/hora/IP, o que o cache-first do
# BibleReaderService já reduz bastante, mas não elimina.
BIBLE_API_BASE_URL=https://www.abibliadigital.com.br/api
BIBLE_API_VERSION_ID=nvi
BIBLE_API_KEY=

# ─── E-mail ───────────────────────────────────────────────────────────────────

RESEND_API_KEY=
MAIL_FROM="Orbien <naoresponda@useorbien.com>"
FRONTEND_URL=https://web.useorbien.com
# Base do link de redefinição de senha do console (`POST /auth/platform/forgot-password`).
ADMIN_URL=https://admin.useorbien.com

# ─── Domínio próprio (Premium) ─────────────────────────────────────────────────

# Chave simétrica de 32 bytes em hex (64 caracteres) — gere com
# `openssl rand -hex 32`. Cifra o access/refresh token da conexão Cloudflare
# de cada tenant e assina o `state` do fluxo OAuth. Sem ela, tanto conectar
# a Cloudflare quanto o callback do OAuth respondem 503.
DOMAIN_SECRETS_ENCRYPTION_KEY=

# App OAuth cadastrado em https://dash.cloudflare.com/oauth2 — sem os dois
# primeiros, "Conectar com Cloudflare" responde 503 em vez de redirecionar.
# CLOUDFLARE_OAUTH_REDIRECT_URI tem que bater exatamente com o cadastrado no
# app (rota pública `GET /public/domains/cloudflare/callback` desta API).
CLOUDFLARE_OAUTH_CLIENT_ID=
CLOUDFLARE_OAUTH_CLIENT_SECRET=
CLOUDFLARE_OAUTH_REDIRECT_URI=https://api.useorbien.com/public/domains/cloudflare/callback
# Escopos do app cadastrado — confira o nome exato no catálogo da Cloudflare
# ao registrar o app; o valor abaixo é o mínimo funcional pretendido (ler
# zona, editar registro DNS).
CLOUDFLARE_OAUTH_SCOPES="zone:read dns_records:edit"

# Token de API da Vercel (escopo do time do projeto apps/web) e os dois IDs
# do projeto — sem eles, tanto o caminho manual quanto o Cloudflare
# registram o DNS mas não conseguem registrar o domínio no projeto, e a
# Vercel nunca emite o certificado.
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
VERCEL_WEB_PROJECT_ID=
