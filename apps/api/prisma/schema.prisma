// =============================================================================
// GRUPO 6 — CONTEÚDO
// =============================================================================

model ContentPost {
  id                 String          @id @default(uuid())
  tenant_id          String
  congregation_id    String
  type               ContentPostType
  title              String
  body               String?
  media_url          String?
  is_draft           Boolean         @default(true)
  publish_at         DateTime?
  published_at       DateTime?
  expires_at         DateTime?
  created_by_user_id String
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt

  // --- Evento (PROD-16) ---
  // Só fazem sentido em `type = event`, e quem cobra isso é o serviço, não o
  // banco: `ContentPostType` já é o discriminador, e uma CHECK constraint
  // amarrada a um valor de enum é a primeira coisa a envelhecer quando o
  // enum cresce. Post que não é evento simplesmente deixa tudo NULL.
  event_starts_at       DateTime?
  event_ends_at         DateTime?
  event_location        String?
  registration_enabled  Boolean   @default(false)
  // NULL é "sem limite". Zero não é vaga nenhuma, é erro de entrada — o DTO
  // exige >= 1.
  registration_limit    Int?
  registration_deadline DateTime?
  // NULL (ou 0) é evento gratuito. Setar preço exige plano Premium — quem
  // cobra isso é o `PostsService`, não o banco, mesmo motivo do resto deste
  // bloco (`PROD-24`).
  registration_price    Decimal?  @db.Decimal(12, 2)

  // --- Destaque no app ---
  // Posição no carrossel da home do mobile, escolhida no web. NULL é "não
  // está em destaque"; o carrossel lista os não nulos em ordem crescente.
  // `PUT /content/posts/highlights` regrava a lista inteira de uma vez, então
  // não há dois posts disputando a mesma posição.
  app_highlight_position Int?

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  createdBy    UserAccount  @relation(fields: [created_by_user_id], references: [id], onDelete: Restrict)

  audienceSegments       AudienceSegment[]
  postSegments           PostSegment[]
  notificationDispatches NotificationDispatch[]
  eventRegistrations     EventRegistration[]

  @@index([tenant_id, id])
  @@index([tenant_id, congregation_id])
  @@index([tenant_id, published_at])
  @@index([tenant_id, congregation_id, app_highlight_position])
  @@map("content_posts")
}

/**
 * Inscrição em evento (PROD-16, variante Starter — sem pagamento).
 * Uma linha por inscrito, e **uma vaga por linha**: não há acompanhante. É
 * escolha de escopo, não esquecimento — "levo dois" tornaria a fila de espera
 * um problema de encaixe (promover quem cabe, e não o próximo), e a igreja que
 * precisa disso cadastra as duas pessoas.
 * `person_id` é opcional porque o organizador inscreve quem ainda não tem
 * cadastro; `full_name` é obrigatório sempre, e para o membro vem do próprio
 * cadastro. Os dois índices únicos parciais que impedem inscrição repetida
 * (por pessoa e por e-mail, cada um ignorando as canceladas) estão na
 * migration: o Prisma não modela unique parcial.
 */
model EventRegistration {
  id                    String                         @id @default(uuid())
  tenant_id             String
  congregation_id       String
  content_post_id       String
  person_id             String?
  full_name             String
  email                 String?
  phone                 String?
  status                EventRegistrationStatus        @default(confirmed)
  /**
   * Quem registrou. NULL quando a própria pessoa se inscreveu.
   */
  registered_by_user_id String?
  cancelled_at          DateTime?
  created_at            DateTime                       @default(now())
  updated_at            DateTime                       @updatedAt
  // --- Pagamento (PROD-24, Premium) ---
  // `not_required` é o evento gratuito de sempre (PROD-16) — nada muda para
  // ele. Evento pago nasce com `status = pending_payment` (fora da contagem
  // de vagas) e só vira `confirmed` quando o webhook da Asaas confirma o
  // pagamento (`PixService.handleWebhook`); nunca no pedido. Ver o cabeçalho
  // do `EventRegistrationsService` para a reserva de vaga de quem está
  // pagando.
  payment_status        EventRegistrationPaymentStatus @default(not_required)
  pix_payment_id        String?                        @unique

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  contentPost  ContentPost  @relation(fields: [content_post_id], references: [id], onDelete: Cascade)
  person       Person?      @relation(fields: [person_id], references: [id], onDelete: SetNull)
  pixPayment   PixPayment?  @relation(fields: [pix_payment_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, id])
  @@index([tenant_id, congregation_id])
  // A ordem da fila de espera e a contagem de vagas saem daqui.
  @@index([content_post_id, status, created_at])
  @@map("event_registrations")
}

model AudienceSegment {
  id              String               @id @default(uuid())
  tenant_id       String
  congregation_id String
  name            String
  criteria        Json
  // Legacy fields — nullable after migration to standalone
  content_post_id String?
  segment_type    AudienceSegmentType?
  segment_value   String?
  created_at      DateTime             @default(now())
  updated_at      DateTime             @updatedAt

  tenant       Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation  @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  contentPost  ContentPost?  @relation(fields: [content_post_id], references: [id], onDelete: Cascade)
  postSegments PostSegment[]

  @@index([tenant_id, congregation_id])
  @@map("audience_segments")
}

model PostSegment {
  post_id    String
  segment_id String

  post    ContentPost     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  segment AudienceSegment @relation(fields: [segment_id], references: [id], onDelete: Cascade)

  @@id([post_id, segment_id])
  @@map("post_segments")
}

model NotificationDispatch {
  id              String              @id @default(uuid())
  tenant_id       String
  congregation_id String
  content_post_id String?
  channel         NotificationChannel
  status          NotificationStatus
  sent_at         DateTime?
  onesignal_id    String?
  reached         Int?
  opened          Int?
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  contentPost  ContentPost? @relation(fields: [content_post_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, id])
  @@index([tenant_id, congregation_id])
  @@index([tenant_id, status])
  @@map("notification_dispatches")
}

// =============================================================================
// GRUPO 7 — VOLUNTARIADO E CELEBRAÇÕES
// =============================================================================

model Ministry {
  id                 String   @id @default(uuid())
  tenant_id          String
  congregation_id    String
  name               String
  description        String?
  color              String?
  parent_ministry_id String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  parent       Ministry?    @relation("MinistryHierarchy", fields: [parent_ministry_id], references: [id])
  children     Ministry[]   @relation("MinistryHierarchy")

  serviceOrderItems          ServiceOrderItem[]
  volunteerMinistries        VolunteerMinistry[]
  celebrationMinistries      CelebrationMinistry[]
  scheduleTemplateMinistries ScheduleTemplateMinistry[]

  @@index([tenant_id, id])
  @@index([tenant_id, congregation_id])
  @@index([parent_ministry_id])
  @@map("ministries")
}

model VolunteerProfile {
  id              String   @id @default(uuid())
  tenant_id       String
  congregation_id String
  person_id       String   @unique
  availability    Json
  skills          Json
  restrictions    String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [person_id], references: [id], onDelete: Cascade)

  volunteerMinistries    VolunteerMinistry[]
  celebrationAssignments CelebrationAssignment[]
  unavailabilities       VolunteerUnavailability[]

  @@index([tenant_id, id])
  @@index([tenant_id, congregation_id])
  @@map("volunteer_profiles")
}

model VolunteerMinistry {
  id                   String                @id @default(uuid())
  tenant_id            String
  congregation_id      String
  volunteer_profile_id String
  ministry_id          String
  role                 VolunteerMinistryRole @default(volunteer)
  is_primary_leader    Boolean               @default(false)
  created_at           DateTime              @default(now())

  volunteerProfile VolunteerProfile @relation(fields: [volunteer_profile_id], references: [id], onDelete: Cascade)
  ministry         Ministry         @relation(fields: [ministry_id], references: [id], onDelete: Cascade)
  tenant           Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation     Congregation     @relation(fields: [congregation_id], references: [id], onDelete: Cascade)

  @@unique([volunteer_profile_id, ministry_id])
  @@index([tenant_id, volunteer_profile_id])
  @@map("volunteer_ministries")
}

model Celebration {
  id              String                @id @default(uuid())
  tenant_id       String
  congregation_id String
  name            String
  type            CelebrationType
  day_of_week     Int?
  start_time      String
  recurrence      CelebrationRecurrence
  anchor_date     DateTime?             @db.Date
  is_active       Boolean               @default(true)
  created_at      DateTime              @default(now())
  updated_at      DateTime              @updatedAt

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation @relation(fields: [congregation_id], references: [id], onDelete: Cascade)

  instances CelebrationInstance[]

  @@index([tenant_id, id])
  @@index([tenant_id, congregation_id])
  @@map("celebrations")
}

model CelebrationInstance {
  id                    String                    @id @default(uuid())
  tenant_id             String
  congregation_id       String
  celebration_id        String
  scheduled_date        DateTime
  status                CelebrationInstanceStatus @default(draft)
  notes                 String?
  host_reminder_sent_at DateTime?
  created_at            DateTime                  @default(now())
  updated_at            DateTime                  @updatedAt

  tenant       Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation         @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  celebration  Celebration          @relation(fields: [celebration_id], references: [id], onDelete: Cascade)
  serviceOrder ServiceOrder?
  schedule     CelebrationSchedule?

  @@index([tenant_id, celebration_id])
  @@index([tenant_id, scheduled_date])
  @@map("celebration_instances")
}

model ServiceOrder {
  id                      String    @id @default(uuid())
  tenant_id               String
  congregation_id         String
  celebration_instance_id String    @unique
  title                   String
  published_at            DateTime?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  tenant              Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation        Congregation        @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  celebrationInstance CelebrationInstance @relation(fields: [celebration_instance_id], references: [id], onDelete: Cascade)

  items ServiceOrderItem[]

  @@index([tenant_id, id])
  @@index([tenant_id, congregation_id])
  @@map("service_orders")
}

model ServiceOrderItem {
  id                   String               @id @default(uuid())
  tenant_id            String
  congregation_id      String
  service_order_id     String
  sequence             Int
  name                 String
  type                 ServiceOrderItemType @default(other)
  start_offset_minutes Int
  duration_minutes     Int
  responsible_type     ResponsibleType
  person_id            String?
  ministry_id          String?
  responsible_label    String?
  notes                String?
  created_at           DateTime             @default(now())
  updated_at           DateTime             @updatedAt

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  serviceOrder ServiceOrder @relation(fields: [service_order_id], references: [id], onDelete: Cascade)
  person       Person?      @relation(fields: [person_id], references: [id], onDelete: SetNull)
  ministry     Ministry?    @relation(fields: [ministry_id], references: [id], onDelete: SetNull)

  setlist Setlist?

  @@index([service_order_id])
  @@index([tenant_id, service_order_id])
  @@map("service_order_items")
}

model Setlist {
  id                    String   @id @default(uuid())
  tenant_id             String
  congregation_id       String
  service_order_item_id String   @unique
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  tenant           Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation     Congregation     @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  serviceOrderItem ServiceOrderItem @relation(fields: [service_order_item_id], references: [id], onDelete: Cascade)

  songs SetlistSong[]

  @@index([tenant_id, congregation_id])
  @@map("setlists")
}

model SetlistSong {
  id              String   @id @default(uuid())
  tenant_id       String
  congregation_id String
  setlist_id      String
  song_id         String?
  sequence        Int
  title           String
  key             String?
  bpm             Int?
  link            String?
  notes           String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  setlist      Setlist      @relation(fields: [setlist_id], references: [id], onDelete: Cascade)
  song         Song?        @relation(fields: [song_id], references: [id], onDelete: SetNull)

  @@index([setlist_id])
  @@index([tenant_id, setlist_id])
  @@map("setlist_songs")
}

model Song {
  id              String   @id @default(uuid())
  tenant_id       String
  congregation_id String
  title           String
  key             String?
  key_alt         String?
  bpm             Int?
  link            String?
  youtube_link    String?
  spotify_link    String?
  cifra_club_link String?
  notes           String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation  @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  setlistSongs SetlistSong[]

  @@index([tenant_id, congregation_id])
  @@index([tenant_id, id])
  @@map("songs")
}

model NotificationPreference {
  id              String   @id @default(uuid())
  tenant_id       String
  congregation_id String
  user_account_id String   @unique
  avisos          Boolean  @default(true)
  oracao          Boolean  @default(true)
  eventos         Boolean  @default(true)
  devocional      Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  userAccount  UserAccount  @relation(fields: [user_account_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, congregation_id])
  @@map("notification_preferences")
}

model CelebrationSchedule {
  id                      String         @id @default(uuid())
  tenant_id               String
  congregation_id         String
  celebration_instance_id String         @unique
  status                  ScheduleStatus @default(draft)
  created_at              DateTime       @default(now())
  updated_at              DateTime       @updatedAt

  celebrationInstance CelebrationInstance   @relation(fields: [celebration_instance_id], references: [id], onDelete: Cascade)
  ministries          CelebrationMinistry[]

  @@index([congregation_id])
  @@map("celebration_schedules")
}

model CelebrationMinistry {
  id              String   @id @default(uuid())
  tenant_id       String
  congregation_id String
  schedule_id     String
  ministry_id     String
  slots           Int      @default(1)
  created_at      DateTime @default(now())

  schedule    CelebrationSchedule     @relation(fields: [schedule_id], references: [id], onDelete: Cascade)
  ministry    Ministry                @relation(fields: [ministry_id], references: [id], onDelete: Restrict)
  assignments CelebrationAssignment[]

  @@unique([schedule_id, ministry_id])
  @@index([congregation_id])
  @@map("celebration_ministries")
}

model CelebrationAssignment {
  id                      String           @id @default(uuid())
  tenant_id               String
  congregation_id         String
  celebration_ministry_id String
  volunteer_profile_id    String
  status                  AssignmentStatus @default(pending)
  notified_at             DateTime?
  responded_at            DateTime?
  checked_in_at           DateTime?
  created_at              DateTime         @default(now())
  updated_at              DateTime         @updatedAt

  celebrationMinistry CelebrationMinistry @relation(fields: [celebration_ministry_id], references: [id], onDelete: Cascade)
  volunteerProfile    VolunteerProfile    @relation(fields: [volunteer_profile_id], references: [id], onDelete: Restrict)

  @@unique([celebration_ministry_id, volunteer_profile_id])
  @@index([congregation_id])
  @@index([volunteer_profile_id])
  @@map("celebration_assignments")
}

model VolunteerUnavailability {
  id                   String   @id @default(uuid())
  tenant_id            String
  congregation_id      String
  volunteer_profile_id String
  reference_month      Int
  reference_year       Int
  notes                String?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  volunteerProfile VolunteerProfile              @relation(fields: [volunteer_profile_id], references: [id], onDelete: Cascade)
  dates            VolunteerUnavailabilityDate[]

  @@unique([volunteer_profile_id, reference_month, reference_year])
  @@index([congregation_id])
  @@map("volunteer_unavailabilities")
}

model VolunteerUnavailabilityDate {
  id                String   @id @default(uuid())
  tenant_id         String
  congregation_id   String
  unavailability_id String
  date              DateTime @db.Date

  unavailability VolunteerUnavailability @relation(fields: [unavailability_id], references: [id], onDelete: Cascade)

  @@unique([unavailability_id, date])
  @@index([congregation_id, date])
  @@map("volunteer_unavailability_dates")
}

model ScheduleTemplate {
  id              String   @id @default(uuid())
  tenant_id       String
  congregation_id String
  name            String
  description     String?
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  ministries ScheduleTemplateMinistry[]

  @@index([congregation_id])
  @@map("schedule_templates")
}

model ScheduleTemplateMinistry {
  id              String @id @default(uuid())
  tenant_id       String
  congregation_id String
  template_id     String
  ministry_id     String
  slots           Int    @default(1)

  template ScheduleTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)
  ministry Ministry         @relation(fields: [ministry_id], references: [id], onDelete: Restrict)

  @@unique([template_id, ministry_id])
  @@index([congregation_id])
  @@map("schedule_template_ministries")
}

// =============================================================================
// GRUPO 8 — AUDITORIA
// =============================================================================

/// Tabela append-only — sem updated_at por design
/// congregation_id é UUID histórico bruto, sem FK: preserva rastreabilidade mesmo após deleção da congregação
model AuditLog {
  id                  String   @id @default(uuid())
  tenant_id           String
  congregation_id     String?
  actor_user_id       String
  subject_person_id   String?
  entity              String
  action              String
  before              Json?
  after               Json?
  ip                  String?
  user_agent          String?
  actor_name_snapshot String?
  at                  DateTime @default(now())

  tenant    Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  actorUser UserAccount @relation("AuditActorUser", fields: [actor_user_id], references: [id], onDelete: Restrict)

  @@index([tenant_id, at])
  @@index([tenant_id, congregation_id])
  @@index([actor_user_id])
  @@index([subject_person_id])
  @@index([entity, action])
  @@map("audit_logs")
}

