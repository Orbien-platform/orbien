// =============================================================================
// ORBIEN — Prisma Schema v1.0
// SaaS white-label de gestão de igrejas | Multi-tenant 3 níveis
// Stack: Prisma + PostgreSQL (Supabase) + NestJS
// Multi-tenancy: shared tables com tenant_id + congregation_id
// RLS: aplicado via migration SQL separada (001_rls_setup.sql)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// GRUPO 1 — FUNDAÇÃO
// =============================================================================

model Tenant {
  id         String   @id @default(uuid())
  slug       String   @unique
  name       String
  email      String?
  phone      String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  congregations             Congregation[]
  brandingConfig            BrandingConfig?
  tenantPlan                TenantPlan?
  userAccounts              UserAccount[]
  roleAssignments           RoleAssignment[]
  persons                   Person[]
  households                Household[]
  classificationHistories   ClassificationHistory[]
  visitRecords              VisitRecord[]
  consentRecords            ConsentRecord[]
  personTags                PersonTag[]
  smallGroups               SmallGroup[]
  networks                  Network[]
  groupTypes                GroupType[]
  groupMemberships          GroupMembership[]
  groupMeetings             GroupMeeting[]
  attendanceRecords         AttendanceRecord[]
  meetingCheckinTokens      MeetingCheckinToken[]
  prayerRequests            PrayerRequest[]
  groupMessages             GroupMessage[]
  bibleVerseMarks           BibleVerseMark[]
  bibleVerseMarkLikes       BibleVerseMarkLike[]
  bibleVerseMarkReplies     BibleVerseMarkReply[]
  studyMaterials            StudyMaterial[]
  studyMaterialVersions     StudyMaterialVersion[]
  materialOpenRecords       MaterialOpenRecord[]
  groupMeetingMaterials     GroupMeetingMaterial[]
  financialCategories       FinancialCategory[]
  costCenters               CostCenter[]
  financialTransactions     FinancialTransaction[]
  transactionAttachments    TransactionAttachment[]
  recurringRules            RecurringRule[]
  pixPayments               PixPayment[]
  donationReceipts          DonationReceipt[]
  contentPosts              ContentPost[]
  eventRegistrations        EventRegistration[]
  audienceSegments          AudienceSegment[]
  notificationDispatches    NotificationDispatch[]
  ministries                Ministry[]
  volunteerProfiles         VolunteerProfile[]
  volunteerMinistries       VolunteerMinistry[]
  celebrations              Celebration[]
  celebrationInstances      CelebrationInstance[]
  serviceOrders             ServiceOrder[]
  serviceOrderItems         ServiceOrderItem[]
  setlists                  Setlist[]
  setlistSongs              SetlistSong[]
  songs                     Song[]
  auditLogs                 AuditLog[]
  qrTokens                  QrToken[]
  exportJobs                ExportJob[]
  importJobs                ImportJob[]
  bankStatementTransactions BankStatementTransaction[]
  notificationPreferences   NotificationPreference[]
  smallGroupVisitRequests   SmallGroupVisitRequest[]

  @@index([id])
  @@map("tenants")
}

model Congregation {
  id            String   @id @default(uuid())
  tenant_id     String
  name          String
  address       String?
  timezone      String   @default("America/Sao_Paulo")
  email         String?
  phone         String?
  logo_url      String?
  /// Logotipo em variante para modo escuro — par de `logo_url` (o claro).
  /// Nulo cai para `logo_url` nos dois modos, mesma lógica de degradação
  /// de `BrandingConfig.logo_url_dark`.
  logo_url_dark String?
  primary_color String?
  /// Cor de destaque (accent) da congregação — o par de `primary_color`,
  /// com a mesma semântica de override: se nula, cai na do tenant, que é
  /// `BrandingConfig.secondary_color`. Ver §6 de apps/mobile/STYLE-GUIDE.md.
  accent_color  String?
  app_name      String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  userAccounts              UserAccount[]
  roleAssignments           RoleAssignment[]
  persons                   Person[]
  households                Household[]
  classificationHistories   ClassificationHistory[]
  visitRecords              VisitRecord[]
  consentRecords            ConsentRecord[]
  personTags                PersonTag[]
  smallGroups               SmallGroup[]
  networks                  Network[]
  groupTypes                GroupType[]
  groupMemberships          GroupMembership[]
  groupMeetings             GroupMeeting[]
  attendanceRecords         AttendanceRecord[]
  meetingCheckinTokens      MeetingCheckinToken[]
  prayerRequests            PrayerRequest[]
  groupMessages             GroupMessage[]
  bibleVerseMarks           BibleVerseMark[]
  bibleVerseMarkLikes       BibleVerseMarkLike[]
  bibleVerseMarkReplies     BibleVerseMarkReply[]
  studyMaterials            StudyMaterial[]
  financialCategories       FinancialCategory[]
  costCenters               CostCenter[]
  financialTransactions     FinancialTransaction[]
  recurringRules            RecurringRule[]
  pixPayments               PixPayment[]
  contentPosts              ContentPost[]
  eventRegistrations        EventRegistration[]
  audienceSegments          AudienceSegment[]
  notificationDispatches    NotificationDispatch[]
  ministries                Ministry[]
  volunteerProfiles         VolunteerProfile[]
  volunteerMinistries       VolunteerMinistry[]
  celebrations              Celebration[]
  celebrationInstances      CelebrationInstance[]
  serviceOrders             ServiceOrder[]
  serviceOrderItems         ServiceOrderItem[]
  setlists                  Setlist[]
  setlistSongs              SetlistSong[]
  songs                     Song[]
  materialOpenRecords       MaterialOpenRecord[]
  groupMeetingMaterials     GroupMeetingMaterial[]
  studyMaterialVersions     StudyMaterialVersion[]
  qrTokens                  QrToken[]
  exportJobs                ExportJob[]
  importJobs                ImportJob[]
  bankStatementTransactions BankStatementTransaction[]
  notificationPreferences   NotificationPreference[]
  smallGroupVisitRequests   SmallGroupVisitRequest[]

  @@index([tenant_id, id])
  @@map("congregations")
}

model BrandingConfig {
  id              String   @id @default(uuid())
  tenant_id       String   @unique
  primary_color   String?
  /// Cor de destaque (accent) do tenant. O nome da coluna é anterior ao
  /// design system, que chama este papel de `accent` — a API expõe o campo
  /// como `accent_color` em `GET /settings` e é assim que o front o
  /// conhece. Renomear a coluna é migration própria; não misturar.
  secondary_color String?
  logo_url        String?
  /// Logotipo em variante para modo escuro — par de `logo_url` (o claro).
  /// Nulo cai para `logo_url` nos dois modos: um tenant que só cadastrou um
  /// logo continua vendo-o em qualquer tema, em vez de ficar sem logo no
  /// escuro.
  logo_url_dark   String?
  app_name        String?
  splash_url      String?
  pix_key         String?
  /// PROD-19 — domínio próprio do tenant (Premium).
  custom_domain   String?  @unique
  /// Provisionamento de fato do `custom_domain` (ver `docs/PLANO.md`):
  /// "pending" enquanto o DNS não aponta/o cert não saiu, "verified" quando
  /// a Vercel confirma o domínio, "failed" quando a última tentativa de
  /// verificação não achou o registro esperado. Sem `custom_domain`, o
  /// valor fica em "pending" e não significa nada — não há coluna própria
  /// para "sem domínio configurado" porque o próprio `custom_domain IS NULL`
  /// já diz isso.
  custom_domain_status String @default("pending")
  /// Access/refresh token da conexão OAuth com a conta Cloudflare do tenant,
  /// cifrados com `SecretCipher` (AES-256-GCM, `DOMAIN_SECRETS_ENCRYPTION_KEY`)
  /// — nunca em texto claro, porque dão acesso de edição de DNS na zona do
  /// tenant. Nulos = tenant não conectou Cloudflare (caminho manual).
  cloudflare_access_token_encrypted  String?
  cloudflare_refresh_token_encrypted String?
  cloudflare_token_expires_at        DateTime?
  /// Zona Cloudflare onde o registro de `custom_domain` foi criado —
  /// guardada para não precisar redescobrir a zona a cada verificação.
  cloudflare_zone_id                 String?
  cloudflare_connected_at            DateTime?
  /// PROD-19 — termos de uso próprios do tenant (Premium), como URL para o
  /// documento (mesmo padrão de `logo_url`/`splash_url`: link, não conteúdo
  /// inline).
  terms_url       String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@map("branding_configs")
}

model TenantPlan {
  id                     String     @id @default(uuid())
  tenant_id              String     @unique
  plan                   PlanType
  status                 PlanStatus
  trial_ends_at          DateTime?
  current_period_ends_at DateTime?
  // Marca o fim do contrato: setado quando status vira `cancelled`, limpo se
  // reativado. É o marco que os jobs de retenção da seção 5 do mapeamento
  // LGPD usam (dado financeiro em 5 anos, dado de menor em 30 dias) — não
  // usar updated_at, que muda por outros motivos sem reiniciar essa janela.
  cancelled_at           DateTime?
  created_at             DateTime   @default(now())
  updated_at             DateTime   @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@map("tenant_plans")
}

// =============================================================================
// GRUPO 2 — AUTH
// =============================================================================

model UserAccount {
  id              String   @id @default(uuid())
  tenant_id       String
  congregation_id String
  person_id       String?
  email           String
  password_hash   String
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  person       Person?      @relation(fields: [person_id], references: [id], onDelete: SetNull)

  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  roleAssignments         RoleAssignment[]
  classificationHistories ClassificationHistory[]
  createdTransactions     FinancialTransaction[]
  uploadedAttachments     TransactionAttachment[]
  createdPosts            ContentPost[]
  actorAuditLogs          AuditLog[]              @relation("AuditActorUser")
  notificationPreference  NotificationPreference?
  studyMaterialVersions   StudyMaterialVersion[]

  @@unique([email])
  @@index([tenant_id, id])
  @@index([tenant_id, congregation_id])
  @@map("user_accounts")
}

/// Tabela de referência global — sem tenant_id
model Role {
  code        String  @id
  name        String
  description String?

  roleAssignments RoleAssignment[]

  @@map("roles")
}

model RoleAssignment {
  id              String   @id @default(uuid())
  tenant_id       String
  congregation_id String
  user_account_id String
  role_code       String
  small_group_id  String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  userAccount  UserAccount  @relation(fields: [user_account_id], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [role_code], references: [code], onDelete: Restrict)
  smallGroup   SmallGroup?  @relation(fields: [small_group_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, id])
  @@index([tenant_id, congregation_id])
  @@index([tenant_id, user_account_id])
  @@map("role_assignments")
}

model RefreshToken {
  id              String    @id @default(uuid())
  user_account_id String
  token_hash      String    @unique
  expires_at      DateTime
  revoked_at      DateTime?
  replaced_by_id  String?
  created_at      DateTime  @default(now())

  userAccount  UserAccount    @relation(fields: [user_account_id], references: [id], onDelete: Cascade)
  replacedBy   RefreshToken?  @relation("TokenRotation", fields: [replaced_by_id], references: [id])
  replacements RefreshToken[] @relation("TokenRotation")

  @@index([user_account_id])
  @@index([token_hash])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  user_id    String
  token      String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user UserAccount @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("password_reset_tokens")
}

model LoginAttempt {
  id         String    @id @default(uuid())
  /// Chave da janela: "<rota>:<e-mail>" — ver LOGIN_LIMIT em auth.service.ts.
  identifier String    @unique
  count      Int       @default(0)
  window_at  DateTime  @default(now())
  /// Preenchido quando a janela estoura; até lá a rota responde 429.
  blocked_at DateTime?

  @@index([window_at])
  @@map("login_attempts")
}

// =============================================================================
// GRUPO 3 — PESSOAS
// =============================================================================

model Person {
  id                   String               @id @default(uuid())
  tenant_id            String
  congregation_id      String
  full_name            String
  phone                String?
  email                String?
  birth_date           DateTime?
  gender               Gender?
  marital_status       MaritalStatus?
  profession           String?
  address_street       String?
  address_number       String?
  address_complement   String?
  address_neighborhood String?
  address_city         String?
  address_state        String?
  address_zip          String?
  photo_url            String?
  baptism_date         DateTime?
  membership_date      DateTime?
  former_denomination  String?
  origin_congregation  String?
  classification       PersonClassification @default(visitor)
  household_id         String?
  deleted_at           DateTime?
  anonymized_at        DateTime?
  anonymization_reason String?
  created_at           DateTime             @default(now())
  updated_at           DateTime             @updatedAt

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  household    Household?   @relation(fields: [household_id], references: [id], onDelete: SetNull)

  userAccounts            UserAccount[]
  householdMemberships    HouseholdMember[]
  classificationHistories ClassificationHistory[]
  visitRecords            VisitRecord[]
  consentRecords          ConsentRecord[]
  personTags              PersonTag[]
  groupMemberships        GroupMembership[]
  attendanceRecords       AttendanceRecord[]
  prayerRequests          PrayerRequest[]
  groupMessages           GroupMessage[]
  bibleVerseMarks         BibleVerseMark[]
  bibleVerseMarkLikes     BibleVerseMarkLike[]
  bibleVerseMarkReplies   BibleVerseMarkReply[]
  materialOpenRecords     MaterialOpenRecord[]
  ledSmallGroups          SmallGroup[]            @relation("GroupLeader")
  ledNetworks             Network[]               @relation("NetworkLeader")
  donorTransactions       FinancialTransaction[]  @relation("TransactionDonor")
  donationReceipts        DonationReceipt[]
  pixDonations            PixPayment[]            @relation("PixDonor")
  volunteerProfile        VolunteerProfile?
  serviceOrderItems       ServiceOrderItem[]
  eventRegistrations      EventRegistration[]

  @@index([tenant_id, id])
  @@index([tenant_id, congregation_id])
  @@index([tenant_id, phone])
  @@index([deleted_at])
  @@map("persons")
}

model Household {
  id              String   @id @default(uuid())
  tenant_id       String
  congregation_id String
  name            String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation @relation(fields: [congregation_id], references: [id], onDelete: Cascade)

  members HouseholdMember[]
  persons Person[]

  @@index([tenant_id, id])
  @@index([tenant_id, congregation_id])
  @@map("households")
}

model HouseholdMember {
  id           String              @id @default(uuid())
  household_id String
  person_id    String
  role         HouseholdMemberRole
  created_at   DateTime            @default(now())
  updated_at   DateTime            @updatedAt

  household Household @relation(fields: [household_id], references: [id], onDelete: Cascade)
  person    Person    @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@unique([household_id, person_id])
  @@index([household_id])
  @@index([person_id])
  @@map("household_members")
}

model ClassificationHistory {
  id                  String               @id @default(uuid())
  tenant_id           String
  congregation_id     String
  person_id           String
  from_classification PersonClassification
  to_classification   PersonClassification
  changed_by_user_id  String
  reason              String?
  changed_at          DateTime             @default(now())
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [person_id], references: [id], onDelete: Cascade)
  changedBy    UserAccount  @relation(fields: [changed_by_user_id], references: [id], onDelete: Restrict)

  @@index([tenant_id, id])
  @@index([tenant_id, congregation_id])
  @@index([tenant_id, person_id])
  @@map("classification_histories")
}

model VisitRecord {
  id              String      @id @default(uuid())
  tenant_id       String
  congregation_id String
  person_id       String
  origin          VisitOrigin
  small_group_id  String?
  visited_at      DateTime
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [person_id], references: [id], onDelete: Cascade)
  smallGroup   SmallGroup?  @relation(fields: [small_group_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, id])
  @@index([tenant_id, congregation_id])
  @@index([tenant_id, person_id])
  @@index([tenant_id, person_id, visited_at])
  @@map("visit_records")
}

model ConsentRecord {
  id                String    @id @default(uuid())
  tenant_id         String
  congregation_id   String
  person_id         String
  version           String
  consented_at      DateTime
  ip                String?
  user_agent        String?
  origin            String?
  revoked_at        DateTime?
  revocation_reason String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, id])
  @@index([tenant_id, congregation_id])
  @@index([tenant_id, person_id])
  @@map("consent_records")
}

model PersonTag {
  id              String   @id @default(uuid())
  tenant_id       String
  congregation_id String
  person_id       String
  tag             String
  is_system_tag   Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, congregation_id, person_id, tag])
  @@index([tenant_id, id])
  @@index([tenant_id, congregation_id])
  @@map("person_tags")
}

// =============================================================================
// GRUPO 4 — PEQUENOS GRUPOS
// =============================================================================

model SmallGroup {
  id                 String   @id @default(uuid())
  tenant_id          String
  congregation_id    String
  name               String
  group_type_id      String
  parent_group_id    String?
  leader_person_id   String
  network_id         String?
  address            String?
  lat                Decimal? @db.Decimal(10, 7)
  lng                Decimal? @db.Decimal(10, 7)
  meeting_time       String?
  recurrence         String?
  is_public          Boolean  @default(false)
  public_description String?
  public_photo_url   String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  groupType    GroupType    @relation(fields: [group_type_id], references: [id], onDelete: Restrict)
  leader       Person       @relation("GroupLeader", fields: [leader_person_id], references: [id], onDelete: Restrict)
  parentGroup  SmallGroup?  @relation("GroupHierarchy", fields: [parent_group_id], references: [id], onDelete: SetNull)
  childGroups  SmallGroup[] @relation("GroupHierarchy")
  network      Network?     @relation(fields: [network_id], references: [id], onDelete: SetNull)

  memberships     GroupMembership[]
  meetings        GroupMeeting[]
  prayerRequests  PrayerRequest[]
  messages        GroupMessage[]
  materialTargets MaterialTarget[]
  visitRecords    VisitRecord[]
  roleAssignments RoleAssignment[]
  visitRequests   SmallGroupVisitRequest[]

  @@index([tenant_id, id])
  @@index([tenant_id, congregation_id])
  @@index([group_type_id])
  @@index([tenant_id, network_id])
  @@map("small_groups")
}

model Network {
  id               String   @id @default(uuid())
  tenant_id        String
  congregation_id  String
  name             String
  leader_person_id String?
  health_goal_pct  Int?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  leader       Person?      @relation("NetworkLeader", fields: [leader_person_id], references: [id], onDelete: SetNull)
  smallGroups  SmallGroup[]

  @@index([tenant_id, id])
  @@index([tenant_id, congregation_id])
  @@map("networks")
}

/// Interesse de visita vindo do "Encontre uma célula" público (PROD-13).
/// Não é presença: quem clicou ainda não foi a lugar nenhum — por isso não
/// é `VisitRecord`, que conta visita acontecida e alimenta a
/// reclassificação automática de visitante para frequentador.
model SmallGroupVisitRequest {
  id              String   @id @default(uuid())
  tenant_id       String
  congregation_id String
  small_group_id  String
  visitor_name    String
  visitor_phone   String?
  visitor_email   String?
  message         String?
  created_at      DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  smallGroup   SmallGroup   @relation(fields: [small_group_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, id])
  @@index([tenant_id, congregation_id])
  @@index([small_group_id, created_at])
  @@map("small_group_visit_requests")
}

model GroupType {
  id              String   @id @default(uuid())
  tenant_id       String
  congregation_id String
  name            String
  color           String?
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  smallGroups  SmallGroup[]

  @@index([tenant_id, congregation_id])
  @@map("group_types")
}

model GroupMembership {
  id              String          @id @default(uuid())
  tenant_id       String
  congregation_id String
  small_group_id  String
  person_id       String
  role            GroupMemberRole
  joined_at       DateTime        @default(now())
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  smallGroup   SmallGroup   @relation(fields: [small_group_id], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@unique([small_group_id, person_id])
  @@index([tenant_id, id])
  @@index([tenant_id, congregation_id])
  @@index([small_group_id])
  @@map("group_memberships")
}

model GroupMeeting {
  id              String   @id @default(uuid())
  tenant_id       String
  congregation_id String
  small_group_id  String
  occurred_at     DateTime
  topic           String?
  observations    String?
  offering_amount Decimal? @db.Decimal(12, 2)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  smallGroup   SmallGroup   @relation(fields: [small_group_id], references: [id], onDelete: Cascade)

  attendanceRecords AttendanceRecord[]
  materials         GroupMeetingMaterial[]
  checkinToken      MeetingCheckinToken?

  @@index([tenant_id, id])
  @@index([tenant_id, congregation_id])
  @@index([small_group_id])
  @@map("group_meetings")
}

model AttendanceRecord {
  id               String   @id @default(uuid())
  tenant_id        String
  congregation_id  String
  group_meeting_id String
  person_id        String
  checked_in_at    DateTime @default(now())
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  groupMeeting GroupMeeting @relation(fields: [group_meeting_id], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@unique([group_meeting_id, person_id])
  @@index([tenant_id, id])
  @@index([tenant_id, congregation_id])
  @@index([group_meeting_id])
  @@map("attendance_records")
}

/// Check-in de presença por QR (PROD-12). Um token por `GroupMeeting`: o
/// líder gera (ou regenera) na hora do encontro, o membro escaneia e a
/// presença é gravada sozinha em `AttendanceRecord`. Não é o mesmo caso de uso
/// de `QrToken` — aquele é do cadastro público de visitante, sem tenant
/// autenticado; este exige `GroupMembership` real e expira em janela curta
/// (`MeetingsService.CHECKIN_TOKEN_TTL_MINUTES`).
model MeetingCheckinToken {
  id               String   @id @default(uuid())
  tenant_id        String
  congregation_id  String
  group_meeting_id String   @unique
  token            String   @unique @default(uuid())
  expires_at       DateTime
  created_by       String
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  groupMeeting GroupMeeting @relation(fields: [group_meeting_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, id])
  @@index([tenant_id, congregation_id])
  @@map("meeting_checkin_tokens")
}

model PrayerRequest {
  id              String   @id @default(uuid())
  tenant_id       String
  congregation_id String
  small_group_id  String
  person_id       String
  content         String
  is_anonymous    Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  smallGroup   SmallGroup   @relation(fields: [small_group_id], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, id])
  @@index([tenant_id, congregation_id])
  @@index([small_group_id])
  @@map("prayer_requests")
}

/// Chat fechado da célula (PROD-09).
///
/// Mesa separada de `PrayerRequest` de propósito: pedido de oração é registro
/// pastoral, que a liderança da célula lê e modera; mensagem de chat é
/// conversa, com volume e paginação próprios. O que as duas compartilham é a
/// regra de acesso — participação no grupo, não papel do JWT.
model GroupMessage {
  id              String    @id @default(uuid())
  tenant_id       String
  congregation_id String
  small_group_id  String
  person_id       String
  content         String
  /// Apagar mensagem é soft delete: o histórico da conversa perderia o fio se
  /// a linha sumisse no meio, e a moderação do líder precisa deixar rastro do
  /// que foi removido. O conteúdo some da resposta da API, não da tabela.
  deleted_at      DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  smallGroup   SmallGroup   @relation(fields: [small_group_id], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, id])
  @@index([tenant_id, congregation_id])
  // A leitura do chat é sempre "as últimas N deste grupo" e a paginação é por
  // created_at desc — o índice composto é o que evita varrer o grupo inteiro.
  @@index([small_group_id, created_at])
  @@map("group_messages")
}

/// Marcação de um ou mais versículos da NVI com comentário, publicada no feed
/// da congregação (biblia-nvi-marcacoes-mobile). Isolada por
/// tenant_id+congregation_id (AD-001, RLS em 020_rls_bible_verse_marks.sql).
/// `verse_start..verse_end` é um intervalo contíguo dentro de um único
/// capítulo — não uma lista arbitrária nem um range cross-capítulo (spec.md,
/// Assumptions).
model BibleVerseMark {
  id                   String    @id @default(uuid())
  tenant_id            String
  congregation_id      String
  person_id            String
  version              String    @default("NVI")
  book_code            String
  chapter              Int
  verse_start          Int
  verse_end            Int
  comment              String
  deleted_at           DateTime?
  deleted_by_person_id String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  tenant       Tenant                @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation          @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  person       Person                @relation(fields: [person_id], references: [id], onDelete: Cascade)
  likes        BibleVerseMarkLike[]
  replies      BibleVerseMarkReply[]

  @@index([tenant_id, id])
  @@index([tenant_id, congregation_id, created_at])
  @@map("bible_verse_marks")
}

/// Curtida de uma marcação do feed da Bíblia — uma por pessoa por marcação
/// (`@@unique`), então curtir de novo é no-op e descurtir apaga a linha.
/// Carrega tenant_id+congregation_id próprios, copiados da marcação, para a
/// RLS de `022_rls_bible_verse_mark_interactions.sql` isolar sem JOIN.
model BibleVerseMarkLike {
  id              String   @id @default(uuid())
  tenant_id       String
  congregation_id String
  mark_id         String
  person_id       String
  created_at      DateTime @default(now())

  tenant       Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation   @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  mark         BibleVerseMark @relation(fields: [mark_id], references: [id], onDelete: Cascade)
  person       Person         @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@unique([mark_id, person_id])
  @@index([tenant_id, congregation_id])
  @@map("bible_verse_mark_likes")
}

/// Resposta a uma marcação do feed da Bíblia. Lista simples, sem resposta de
/// resposta e sem edição — o autor apaga a própria, a moderação apaga
/// qualquer uma da congregação (soft delete, mesma distinção de
/// `deleted_by_person_id` que `BibleVerseMark` faz).
model BibleVerseMarkReply {
  id                   String    @id @default(uuid())
  tenant_id            String
  congregation_id      String
  mark_id              String
  person_id            String
  comment              String
  deleted_at           DateTime?
  deleted_by_person_id String?
  created_at           DateTime  @default(now())

  tenant       Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  congregation Congregation   @relation(fields: [congregation_id], references: [id], onDelete: Cascade)
  mark         BibleVerseMark @relation(fields: [mark_id], references: [id], onDelete: Cascade)
  person       Person         @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@index([mark_id, created_at])
  @@index([tenant_id, congregation_id])
  @@map("bible_verse_mark_replies")
}

/// Cache do texto de um capítulo da NVI, buscado da API bíblica externa na
/// primeira vez e reaproveitado depois (AD-005, .specs/STATE.md). Tabela
/// GLOBAL de propósito — sem tenant_id/congregation_id: o texto bíblico é o
/// mesmo para toda igreja, RLS habilitada com `USING (true)` explícito em vez
/// de isolamento por tenant (que não teria dono nenhum aqui).
model BibleChapterCache {
  id         String   @id @default(uuid())
  version    String
  book_code  String
  chapter    Int
  verses     Json
  fetched_at DateTime @default(now())

  @@unique([version, book_code, chapter])
  @@map("bible_chapter_cache")
}

