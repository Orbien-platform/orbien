# O browser chama /api-proxy no próprio admin → rewrite do Next.js → API.
# Versionado igual ao apps/web/.env.production, e pelo mesmo motivo: se esta
# variável faltar, `baseURL` do axios fica undefined e toda chamada resolve
# contra a origem do console — 404 da Vercel, sem sintoma que aponte a causa.
NEXT_PUBLIC_API_URL=/api-proxy

# API_BACKEND_URL (server-only) e NEXT_PUBLIC_WEB_URL são definidos no painel
# da Vercel — ver DEPLOY.md, Parte 4.
