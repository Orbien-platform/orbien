# URL que o browser usa para chamar a API (proxiada pelo Next.js — sem CORS)
NEXT_PUBLIC_API_URL=/api-proxy

# URL real do backend (usada apenas no servidor — para o rewrite do Next.js)
API_BACKEND_URL=http://localhost:3000/api

# Onde a sessão de suporte é aberta. Em produção: https://web.useorbien.com.br
NEXT_PUBLIC_WEB_URL=http://localhost:3001
