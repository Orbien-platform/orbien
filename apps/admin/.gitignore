# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
# `next-env.d.ts` NÃO entra aqui, diferente do apps/web: ele é versionado neste
# app de propósito (`chore: versiona apps/admin/next-env.d.ts`), para sessão
# remota conseguir rodar `tsc` sem antes rodar o `next build` que o gera.
# Manter a regra faria a linha ignorada contradizer o arquivo rastreado.
