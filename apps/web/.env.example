# URL que o browser usa para chamar a API (proxiada pelo Next.js — sem CORS)
NEXT_PUBLIC_API_URL=/api-proxy

# URL real do backend (usada apenas no servidor — pelo handler de /api-proxy)
API_BACKEND_URL=http://localhost:3000/api

# URL real da API vista pelo browser. Existe só para o upload de mídia, que
# não pode passar pelo /api-proxy: função da Vercel tem teto de 4,5MB de corpo
# e o produto aceita 50MB. É a única chamada cross-origin do web, então o
# domínio do web precisa estar em ALLOWED_ORIGINS no Render.
NEXT_PUBLIC_API_UPLOAD_URL=http://localhost:3000/api

# Segredo compartilhado com a API (mesmo valor nas duas pontas), usado só no
# servidor — nunca NEXT_PUBLIC_. Autoriza o handler de /api-proxy a dizer à API
# qual é o IP do visitante; sem ele, todas as chamadas públicas chegam lá com o
# endereço da função da Vercel e dividem o mesmo limite de taxa.
ORBIEN_PROXY_SECRET=
