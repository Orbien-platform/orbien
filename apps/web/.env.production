# Produção: o browser chama /api-proxy → Route Handler do Next → Render.
# API_BACKEND_URL é definida no dashboard da Vercel (server-only).
NEXT_PUBLIC_API_URL=/api-proxy

# Exceção, e só ela: o upload de mídia vai direto para a API. O /api-proxy é
# uma função da Vercel, com teto de 4,5MB de corpo, e o produto aceita 50MB.
# É a única chamada cross-origin do web — o domínio do web precisa estar em
# ALLOWED_ORIGINS no Render.
NEXT_PUBLIC_API_UPLOAD_URL=https://orbien-api.onrender.com/api
