{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "extends": "generic",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "extends": "generic",
      "distribution": "internal",
      "env": {
        "ORBIEN_API_URL": "https://orbien-api.onrender.com/api"
      }
    },
    "preview-ios-simulator": {
      "extends": "generic",
      "distribution": "internal",
      "env": {
        "ORBIEN_API_URL": "https://orbien-api.onrender.com/api"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "extends": "generic",
      "autoIncrement": true,
      "env": {
        "ORBIEN_API_URL": "https://orbien-api.onrender.com/api",
        "ORBIEN_ONESIGNAL_APP_ID": "wvnuq62y5uqgnqhyapm5synjd"
      }
    },
    "generic": {
      "env": {
        "ORBIEN_APP_NAME": "Orbien",
        "ORBIEN_APP_SLUG": "orbien",
        "ORBIEN_APP_SCHEME": "orbien",
        "ORBIEN_BUNDLE_ID": "com.orbien.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
